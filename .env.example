# Resend (https://resend.com) — server only, never exposed to the client
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend
DEMO_FROM="Medicore <demo@medicoresv.health>"
DEMO_TO=hello@medicoresv.health

# Cloudflare Turnstile (optional; if empty the widget is not rendered and not verified)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
