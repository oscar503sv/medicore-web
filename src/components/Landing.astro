---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import SpecialtyStrip from './SpecialtyStrip.astro';
import Features from './Features.astro';
import Steps from './Steps.astro';
import Audience from './Audience.astro';
import Security from './Security.astro';
import Pricing from './Pricing.astro';
import { plans } from '../data/plans';
import Faq from './Faq.astro';
import DemoForm from './DemoForm.astro';
import { routes, useTranslations, type Lang } from '../i18n/utils';
import { SITE_URL, APP_URL, CONTACT_EMAIL } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pageUrl = new URL(routes.home[lang], SITE_URL).href;
const orgId = `${SITE_URL}/#organization`;
const priced = plans.flatMap((p) => (p.price === null ? [] : [p.price]));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: 'Medicore',
    url: SITE_URL,
    logo: `${SITE_URL}/apple-touch-icon.png`,
    email: CONTACT_EMAIL,
    areaServed: { '@type': 'Country', name: 'El Salvador' },
    address: { '@type': 'PostalAddress', addressCountry: 'SV' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Medicore',
    description: t.meta.description,
    url: pageUrl,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'HealthApplication',
    operatingSystem: 'Web',
    inLanguage: ['es', 'en'],
    installUrl: APP_URL,
    publisher: { '@id': orgId },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: Math.min(...priced),
      highPrice: Math.max(...priced),
      offerCount: priced.length,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base lang={lang} route="home" jsonLd={jsonLd}>
  <Hero lang={lang} />
  <SpecialtyStrip lang={lang} />
  <Features lang={lang} />
  <Audience lang={lang} />
  <Security lang={lang} />
  <Pricing lang={lang} />
  <Steps lang={lang} />
  <Faq lang={lang} />
  <DemoForm lang={lang} />
</Base>
