---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<section id="equipo" class="section container" aria-labelledby="who-title">
  <h2 id="who-title" class="h2">{t.who.title}</h2>
  <p class="lead">{t.who.sub}</p>
  <div class="grid">
    {
      t.who.items.map((w) => (
        <article class:list={['card', w.tone]}>
          <span class="kicker">{w.kicker}</span>
          <h3>{w.title}</h3>
          <ul>
            {w.points.map((p) => (
              <li>
                <span class="bullet" aria-hidden="true" />
                {p}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    margin-top: 48px;
  }
  .card {
    border-radius: 28px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 300px;
    color: var(--ink);
  }
  .white {
    background: #fff;
    --chip: var(--bg);
  }
  .mint {
    background: var(--primary-light);
    --chip: rgba(255, 255, 255, 0.7);
  }
  .ink {
    background: var(--ink);
    color: #fff;
    --chip: rgba(255, 255, 255, 0.12);
  }
  .kicker {
    align-self: flex-start;
    font-weight: 700;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--chip);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-top: 8px;
  }
  ul {
    margin-top: auto;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  li {
    display: flex;
    gap: 10px;
    font-size: 15.5px;
    line-height: 1.5;
    font-weight: 500;
  }
  .bullet {
    flex: none;
    margin-top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
