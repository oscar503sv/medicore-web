---
import { Image } from 'astro:assets';
import FloatingIcons from './FloatingIcons.astro';
import heroDashboard from '../assets/hero-dashboard.png';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero container">
  <FloatingIcons />
  <div class="copy">
    <span class="pill"><span class="dot" aria-hidden="true"></span>{t.hero.pill}</span>
    <h1>{t.hero.l1} <span class="accent">{t.hero.l2}</span></h1>
    <p class="sub">{t.hero.sub}</p>
    <div class="ctas">
      <a class="btn btn-primary cta" href="#demo">{t.hero.cta}</a>
      <a class="btn btn-light cta" href="#funciones">{t.hero.cta2}</a>
    </div>
    <p class="fine">{t.hero.fine}</p>
  </div>

  <div class="panel">
    <div class="panel-circle" aria-hidden="true"></div>
    <div class="shot">
      <Image
        src={heroDashboard}
        alt={t.ui.heroImgAlt}
        widths={[640, 940, 1280, 1740]}
        format="webp"
        quality={90}
        sizes="(min-width: 1100px) 940px, calc(100vw - 64px)"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="float-card card-a" aria-hidden="true">
      <span class="time">10:30</span>
      <span class="who"><strong>{t.hero.c1a}</strong><span>{t.hero.c1b}</span></span>
    </div>
    <div class="float-card card-b" aria-hidden="true">
      <span class="label">{t.hero.c2a}</span>
      <span class="num">12 <span class="delta">{t.hero.c2b}</span></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: 40px;
  }
  .copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 860px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-light);
    color: var(--ink);
    font-weight: 700;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 7.2vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin-top: 24px;
  }
  .accent {
    color: var(--primary);
  }
  .sub {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
    max-width: 560px;
    margin-top: 24px;
    color: var(--ink-80);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .cta {
    font-size: 17px;
    padding: 17px 28px;
  }
  .fine {
    font-size: 14px;
    font-weight: 500;
    margin-top: 16px;
    color: var(--ink-60);
  }

  .panel {
    position: relative;
    margin-top: 56px;
    background: var(--primary-light);
    border-radius: 36px;
    padding: clamp(20px, 4vw, 56px) clamp(16px, 4vw, 56px) 0;
    overflow: hidden;
  }
  .panel-circle {
    position: absolute;
    right: -80px;
    top: -80px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.9;
  }
  .shot {
    position: relative;
    max-width: 940px;
    margin: 0 auto;
    aspect-ratio: 16 / 9.5;
    background: #fff;
    border-radius: 20px 20px 0 0;
    box-shadow: 0 30px 80px -30px rgba(38, 33, 48, 0.35);
    overflow: hidden;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .float-card {
    position: absolute;
    border-radius: 18px;
  }
  .card-a {
    left: clamp(12px, 4vw, 48px);
    top: clamp(60px, 14vw, 180px);
    background: #fff;
    padding: 14px 16px;
    box-shadow: 0 18px 40px -16px rgba(38, 33, 48, 0.35);
    display: flex;
    gap: 12px;
    align-items: center;
    max-width: 260px;
  }
  .time {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--primary-light);
    color: var(--primary);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 14px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .who strong {
    font-size: 14px;
  }
  .who span {
    font-size: 13px;
    color: var(--ink-60);
  }
  .card-b {
    right: clamp(12px, 4vw, 48px);
    bottom: clamp(20px, 6vw, 72px);
    background: var(--ink);
    color: #fff;
    padding: 14px 18px;
    box-shadow: 0 18px 40px -16px rgba(38, 33, 48, 0.5);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .label {
    font-size: 13px;
    opacity: 0.7;
  }
  .num {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .delta {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--primary-light);
  }

  @media (max-width: 640px) {
    .float-card {
      transform: scale(0.82);
    }
    .card-a {
      transform-origin: top left;
    }
    .card-b {
      transform-origin: bottom right;
    }
  }
  @media (max-width: 480px) {
    .float-card {
      display: none;
    }
  }
</style>
